# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Vector store ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- LLM providers (only needed if llm.provider != local) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
